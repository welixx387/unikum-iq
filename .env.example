# Глобальный реестр заданий (необязательно).
#
# Без этих переменных тест работает полностью в браузере: задания
# генерируются с огромным пространством вариантов, а на одном устройстве
# повтор исключён локальной историей.
#
# Чтобы исключить повторы и между разными людьми, подключите бесплатный
# проект Supabase (см. README.md → «Глобальная уникальность заданий»):
#   1. Выполните supabase/iq-test.sql в SQL Editor проекта
#   2. Скопируйте этот файл в .env.local и вставьте свои значения
#      (Project Settings → API)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
